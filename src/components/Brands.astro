---
import { brands } from '../config';
import { asset } from '../utils';
---
<!-- BRANDS — the ground shifts to the section indigo for this chapter -->
<section id="brands" class="brands" data-ground>
  <div class="wrap" data-scene="view">
    <div class="kicker">{brands.kicker}</div>
    <h2 class="h-section rv" data-w="0 0.4">{brands.title}</h2>
    <p class="lede rv" data-w="0.1 0.4">{brands.lede}</p>
  </div>
  <div class="wrap brand-grid" data-scene="view">
    {brands.items.map((b, i) => (
      <div class="brand rv" data-w="0 0.5 0.05" data-i={i}>
        <div>
          {b.logo
            ? <img src={asset(b.logo)} alt={b.name} loading="lazy">
            : <span class="brand-name">{b.name}</span>}
        </div>
      </div>
    ))}
  </div>
</section>
