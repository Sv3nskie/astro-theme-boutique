---
import { site, nav } from '../config';
import { asset, splitAmp } from '../utils';
const parts = splitAmp(site.name);
---
<nav class="site-nav" aria-label="Main">
  <a class="nav-brand" href="#top">
    <img src={asset(site.logo)} alt="">
    <span>{parts.map((p, i) => <>{i > 0 && '&'}{p}</>)}</span>
  </a>
  <div class="nav-links">
    {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
  </div>
  <a class="btn btn-primary" href={nav.cta.href}>{nav.cta.label}</a>
</nav>
<div class="progress" aria-hidden="true"></div>
