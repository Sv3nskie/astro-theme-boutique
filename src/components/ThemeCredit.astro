---
import { credit } from '../config';

// Build the tracked URL: the base utm parameters plus the hosting site's hostname,
// so the author can tell which sites the traffic comes from.
const link = new URL(credit.url);
for (const [k, v] of Object.entries(credit.utm)) link.searchParams.set(k, v);
link.searchParams.set('utm_content', Astro.site?.hostname ?? Astro.url.hostname);
---
{credit.enabled && (
  <a class="theme-credit" href={link.href} target="_blank" rel="noopener">{credit.label}</a>
)}
