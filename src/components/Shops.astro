---
import { shops } from '../config';
import { asset } from '../utils';
const n = shops.items.length;
---
<!-- THE SHOPS -->
<section id="shops" class="shops" data-scene="view">
  <div class="wrap">
    <div class="kicker">{shops.kicker}</div>
    <h2 class="h-section rv" data-w="0 0.4">{shops.title}</h2>
    <div class="rule" aria-hidden="true"></div>
    <div class="shop-grid">
      {shops.items.map((s, i) => (
        <div class="shop rv" data-w="0.15 0.4 0.08" data-i={i}>
          <div class="shop-index">{String(i + 1).padStart(2, '0')}</div>
          <h3>{s.name}</h3>
          <p class="shop-address">{s.address.map((line, j) => <>{j > 0 && <br />}{line}</>)}</p>
          <p class="shop-open">{shops.openLabel}</p>
          <p class="shop-hours">{s.hours}</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={s.directionsUrl}>{shops.directionsLabel}</a>
            <a class="btn btn-secondary" href={s.whatsappUrl}>{shops.whatsappLabel}</a>
          </div>
        </div>
      ))}
      <div class="rv" data-w="0.15 0.4 0.08" data-i={n}>
        <figure class="shopfront">
          <div><img src={asset(shops.photo.src)} alt={shops.photo.alt} loading="lazy"></div>
          <figcaption class="caption">{shops.photo.caption}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
