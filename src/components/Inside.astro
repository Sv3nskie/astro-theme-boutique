---
import { inside } from '../config';
import { asset } from '../utils';
---
<!-- INSIDE — the rooms themselves; frames drop in at different depths -->
<section id="inside" class="inside" data-scene="par" data-ground>
  <div class="wrap">
    <header class="head-row">
      <div>
        <div class="kicker">{inside.kicker}</div>
        <h2 class="h-section rv" data-w="0.08 0.3">{inside.title}</h2>
      </div>
      <p class="lede rv" data-w="0.12 0.3">{inside.lede}</p>
    </header>
    <div class="inside-grid">
      {inside.rooms.map((r) => (
        <figure class:list={['room', 'rv', { 'room--tall': r.tall }]} data-rel data-w={r.tall ? '0.28 0.4' : '0.22 0.4'} style={`--d: ${r.offset}`}>
          <div class="room-frame" style={`--ar: ${r.ratio}`}>
            <div class="room-drift" style={`--drift: ${r.drift}`}><img src={asset(r.src)} alt={r.alt} loading="lazy"></div>
          </div>
          <figcaption class="caption"><span>{r.caption[0]}</span><span>{r.caption[1]}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
