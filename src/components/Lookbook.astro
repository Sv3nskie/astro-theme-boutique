---
import { lookbook } from '../config';
import { asset } from '../utils';
---
<!-- LOOKBOOK — pinned; vertical scroll scrubs the track sideways, each frame drifts slowly inside -->
<section id="lookbook" class="pin lookbook" data-scene="pin">
  <div class="stage">
    <header class="head-row">
      <div>
        <div class="kicker">{lookbook.kicker}</div>
        <h2 class="h-section h-section--sm">{lookbook.title}</h2>
      </div>
      <div class="scrub" aria-hidden="true">
        <span>{lookbook.scrub}</span>
        <span class="scrub-bar"></span>
      </div>
    </header>

    <div class="track" data-track>
      {lookbook.looks.map((l) => (
        <figure class="look">
          <div class="look-frame" style={`--h: ${l.height}; --ar: ${l.ratio}`}>
            <div class:list={['look-drift', { lighten: l.blend }]} style={`--drift: ${l.drift}`}>
              <img src={asset(l.src)} alt={l.alt} style={l.pos ? `object-position: ${l.pos}` : undefined} loading="lazy">
            </div>
            <div class="look-edge" aria-hidden="true"></div>
          </div>
          <figcaption class="caption"><span>{l.caption[0]}</span><span>{l.caption[1]}</span></figcaption>
        </figure>
      ))}
      <a class="card elev-sm look-end" href={lookbook.end.href}>
        <span>{lookbook.end.title}</span>
        <span>{lookbook.end.label}</span>
      </a>
    </div>
  </div>
</section>
