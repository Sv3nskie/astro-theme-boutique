---
import { wine } from '../config';
import { asset } from '../utils';
const [first, second] = wine.images;
---
<!-- FULL-BLEED BAND — parallax photo crossfade with a pull quote -->
<section class="wine dark" data-scene="par">
  <div class="wine-photo lighten">
    <img src={asset(first.src)} alt={first.alt} loading="lazy">
  </div>
  <div class="wine-photo wine-photo--next">
    <img src={asset(second.src)} alt={second.alt} loading="lazy">
  </div>
  <div class="wine-wash" aria-hidden="true"></div>
  <div class="wine-copy">
    <div class="kicker">{wine.kicker}</div>
    <blockquote class="rv" data-w="0.18 0.3">{wine.quote}</blockquote>
    <p class="lede rv" data-w="0.26 0.3">{wine.lede}</p>
  </div>
</section>
